<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- X-Rite 네이티브 DLL(보통 32비트 또는 64비트 고정)과 맞춰야 함.
         SDK가 32비트 전용이면 x86으로, 64비트면 x64로 맞춰야 P/Invoke가 로드됨.
         SDK 설치 안내서에서 "x86" 또는 "x64" 표기를 확인해서 아래 값을 맞출 것. -->
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NixUniversalSDK" Version="4.2.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- X-Rite 네이티브 DLL을 빌드 출력 폴더로 복사 (P/Invoke가 파일명으로 찾음) -->
    <None Include="native\eXact.dll" Link="eXact.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
